# Variables para docker compose. Copiá este archivo como .env y completalo.
# Generá claves con: node -p "require('node:crypto').randomBytes(32).toString('hex')"
MYSQL_PASSWORD=
SESSION_SECRET=
# Primer administrador del panel: se crea al arrancar si la base no tiene ninguno.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Puerto de la máquina donde queda el sitio (http://localhost:3000).
PUERTO=3000
# Opcionales: HTTPS detrás de un proxy, correo del formulario e imágenes de las novedades.
COOKIE_SECURE=false
TRUST_PROXY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=
CLOUDINARY_URL=
