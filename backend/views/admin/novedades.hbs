<div class="herramientas">
  <p class="tenue">Las novedades aparecen en la página de inicio, de la más reciente a la más antigua.</p>
  <a class="boton primario" href="/admin/novedades/agregar">{{> icono nombre="mas"}} Nueva novedad</a>
</div>

{{#if novedades.length}}
<ul class="lista-novedades">
  {{#each novedades}}
  <li class="tarjeta novedad">
    {{#if imagen}}
    <img src="{{imagen}}" alt="" width="80" height="80">
    {{else}}
    <span class="sin-imagen" aria-hidden="true">{{> icono nombre="novedades"}}</span>
    {{/if}}
    <div>
      <h2>{{titulo}}</h2>
      <p class="tenue">{{subtitulo}} · {{fechaCorta creada}}</p>
    </div>
    <div class="turno-acciones">
      <a class="boton-icono" href="/admin/novedades/modificar/{{id}}" title="Editar" aria-label="Editar «{{titulo}}»">{{> icono nombre="editar"}}</a>
      <form action="/admin/novedades/eliminar/{{id}}" method="post">
        <input type="hidden" name="csrfToken" value="{{@root.csrfToken}}">
        <button type="submit" class="boton-icono peligro" title="Eliminar" aria-label="Eliminar «{{titulo}}»" data-confirmar="¿Eliminar la novedad «{{titulo}}»? No se puede deshacer.">{{> icono nombre="borrar"}}</button>
      </form>
    </div>
  </li>
  {{/each}}
</ul>
{{else}}
<p class="tarjeta vacio">Todavía no hay novedades. Publicá la primera para que aparezca en el inicio del sitio.</p>
{{/if}}
