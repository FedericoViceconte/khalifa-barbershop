#!/usr/bin/env node
// Arranca el servidor: prepara la base (crea las tablas que falten) y escucha en HOST:PORT.
const http = require('node:http');
const app = require('../app');
const pool = require('../models/bd');
const { prepararBase } = require('../models/esquema');

const port = Number(process.env.PORT) || 3000;
const host = process.env.HOST || '127.0.0.1';

async function main() {
  await prepararBase({ intentos: 10 });
  const server = http.createServer(app);

  server.on('error', (error) => {
    if (error.code === 'EADDRINUSE') console.error(`El puerto ${port} ya está en uso.`);
    else console.error(error);
    process.exit(1);
  });

  server.listen(port, host, () => console.log(`Khalifa Barbershop en http://${host}:${port}`));

  // Docker envía SIGTERM al detener el contenedor: se cierran las conexiones antes de salir.
  for (const senal of ['SIGTERM', 'SIGINT']) {
    process.once(senal, () => {
      server.close(() => pool.end().finally(() => process.exit(0)));
      setTimeout(() => process.exit(0), 5000).unref();
    });
  }
}

main().catch((error) => {
  console.error(`No se pudo iniciar: ${error.code || error.message}`);
  process.exit(1);
});
