#!/usr/bin/env node
// Crea un administrador: ADMIN_PASSWORD=... npm run create-admin -- usuario
require('dotenv').config({ path: require('node:path').join(__dirname, '../.env'), quiet: true });
const pool = require('../models/bd');
const { crearTablas } = require('../models/esquema');
const { crearUsuario } = require('../models/usuariosModel');

async function main() {
  const usuario = process.argv[2];
  if (!usuario || !process.env.ADMIN_PASSWORD) {
    throw new Error('Indicá el usuario como argumento y la contraseña en la variable ADMIN_PASSWORD.');
  }
  await crearTablas();
  await crearUsuario(usuario, process.env.ADMIN_PASSWORD);
  console.log(`Administrador ${usuario} creado.`);
}

main()
  .catch((error) => {
    console.error(error.code === 'ER_DUP_ENTRY' ? 'Ese usuario ya existe.' : error.code || error.message);
    process.exitCode = 1;
  })
  .finally(() => pool.end());
