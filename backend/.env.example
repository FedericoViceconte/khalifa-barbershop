HOST=127.0.0.1
PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB_NAME=khalifa_barbershop
MYSQL_USER=
MYSQL_PASSWORD=
# Al menos 32 caracteres: node -p "require('node:crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=
# mysql guarda las sesiones del panel en la base; memoria las pierde al reiniciar.
SESSION_STORE=mysql
# true si el sitio se sirve por HTTPS (cookies seguras y HSTS).
COOKIE_SECURE=false
# Cantidad de proxies inversos delante del servidor (por ejemplo 1 con Nginx).
TRUST_PROXY=
# Primer administrador: se crea al arrancar solo si la base no tiene ninguno.
ADMIN_USER=
ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=
CLOUDINARY_URL=
